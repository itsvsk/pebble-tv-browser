    "views": [
      {
        "viewName": "most_visited",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT url,\n                      MAX(title) AS title,\n                      COUNT(*) AS visitCount,\n                      MAX(visitedAt) AS lastVisited\n               FROM history\n               GROUP BY url\n               ORDER BY visitCount DESC, lastVisited DESC\n               LIMIT 20"
      }
